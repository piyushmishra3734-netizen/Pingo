node_modules/
dist/
build/
.DS_Store
*.local
.env
.env.*
!.env.example
*.tsbuildinfo
.vite/
coverage/

# Claude Code local settings — personal, never shared.
.claude/settings.local.json

# Capacitor native build output.
#
# The Android project itself IS committed -- it holds the manifest, the icons
# and the Gradle config, all of which are source. What is ignored is what a
# build produces from them.
apps/web/android/app/build/
apps/web/android/build/
apps/web/android/.gradle/
apps/web/android/local.properties
apps/web/ios/App/Pods/
apps/web/ios/App/build/

# Play upload key. Never committed -- Play accepts one upload key for the life
# of an app, and losing it means you cannot update your own listing.
apps/web/android/keystore.properties
apps/web/android/*.jks
apps/web/android/*.keystore
