{
  "name": "pingo-desktop",
  "productName": "PINGO",
  "version": "1.0.0",
  "private": true,
  "description": "PINGO for Windows",
  "author": "PINGO",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "chat.pingo.desktop",
    "productName": "PINGO",
    "copyright": "PINGO",
    "files": ["main.cjs", "build/icon.png"],
    "directories": { "output": "dist" },
    "protocols": [{ "name": "PINGO", "schemes": ["pingo"] }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PINGO",
      "artifactName": "PINGO-Setup.exe"
    }
  }
}
