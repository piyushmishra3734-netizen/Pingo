{
  "name": "pingo",
  "version": "0.1.0",
  "private": true,
  "description": "PINGO. Connect. Privately. A calm, premium communication platform.",
  "scripts": {
    "dev": "pnpm --filter @pingo/web dev",
    "build": "pnpm --filter @pingo/web build",
    "preview": "pnpm --filter @pingo/web preview",
    "typecheck": "pnpm -r typecheck",
    "check:docs": "node docs/.check-wireframes.mjs && node docs/.check-links.mjs",
    "build:splash": "node apps/web/scripts/make-splash.mjs",
    "build:logo": "node --experimental-strip-types apps/web/scripts/make-logo.ts",
    "release:android": "node apps/web/scripts/release-android.mjs",
    "verify:qr": "node --experimental-strip-types apps/web/scripts/verify-qr.ts",
    "verify:crypto": "node apps/web/scripts/verify-crypto.mjs",
    "verify:recovery": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-recovery.ts",
    "bench": "node apps/web/scripts/benchmark.mjs",
    "functions:deploy": "supabase functions deploy turn-credentials ai-chat --project-ref lppzoqgvshhmxqsvggug",
    "check": "pnpm typecheck && pnpm check:docs && pnpm verify:qr && pnpm verify:crypto && pnpm verify:recovery",
    "verify:recovery-wrap": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-recovery-wrap.ts",
    "verify:secure-backup": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-secure-backup.ts",
    "verify:archive": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-archive.ts",
    "verify:drive": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-drive.ts",
    "verify:drive-target": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-drive-target.ts",
    "verify:drive-ui": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-drive-ui.ts",
    "verify:archive-builder": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-archive-builder.ts",
    "verify:drive-streaming": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-drive-streaming.ts",
    "verify:backup-ux": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-backup-ux.ts",
    "verify:key-isolation": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-key-isolation.ts",
    "verify:backfill": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-backfill.ts",
    "verify:preflight": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-preflight.ts",
    "verify:receipt": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-receipt.ts",
    "verify:completeness": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-completeness.ts",
    "verify:verification": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-verification.ts",
    "verify:pipeline": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-pipeline.ts",
    "verify:archive-key": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-archive-key.ts",
    "verify:voice-wav": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-voice-wav.ts",
    "verify:message-sounds": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-message-sounds.ts",
    "verify:badges": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-badges.ts",
    "verify:chapters": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-chapters.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.109.1",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
