{
  "name": "pingo",
  "version": "0.1.0",
  "private": true,
  "description": "PINGO — Connect. Privately. A calm, premium communication platform.",
  "scripts": {
    "dev": "pnpm --filter @pingo/web dev",
    "build": "pnpm --filter @pingo/web build",
    "preview": "pnpm --filter @pingo/web preview",
    "typecheck": "pnpm -r typecheck",
    "check:docs": "node docs/.check-wireframes.mjs && node docs/.check-links.mjs",
    "build:logo": "node --experimental-strip-types apps/web/scripts/make-logo.ts",
    "release:android": "node apps/web/scripts/release-android.mjs",
    "verify:qr": "node --experimental-strip-types apps/web/scripts/verify-qr.ts",
    "verify:crypto": "node apps/web/scripts/verify-crypto.mjs",
    "verify:recovery": "node apps/web/scripts/run-ts.mjs apps/web/scripts/verify-recovery.ts",
    "functions:deploy": "supabase functions deploy turn-credentials --project-ref lppzoqgvshhmxqsvggug",
    "check": "pnpm typecheck && pnpm check:docs && pnpm verify:qr && pnpm verify:crypto && pnpm verify:recovery"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.109.1",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
