# PINGO — web environment
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
#   cp apps/web/.env.example apps/web/.env
#
# `.env` is gitignored. Never commit real credentials.
#
# Note on the anon key: it is safe to expose in a browser bundle by design —
# it only grants what Row Level Security policies allow. The service_role key
# is NOT safe and must never appear in this file or anywhere in apps/web.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
