<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Auto Backup is off, and stays off.

        It copies the app's private data directory to the user's Google Drive,
        and that directory holds the WebView's IndexedDB: the sealed message
        cache, and the stored CryptoKey material for the device identity and
        database key. Non extractable stops JavaScript exporting a key. It does
        not stop the platform copying the bytes of the file it is stored in.

        Whether this WebView's key storage is actually captured has not been
        tested on a device, so this is a suspected inconsistency with the threat
        model rather than a proven one. It is switched off anyway: PINGO backs
        up through its own encrypted Drive archive, where the app chooses what
        leaves the device and encrypts it first. A platform mechanism that
        decides both of those for us is not something an end to end encrypted
        product should rely on.

        This also disables device to device transfer of app data, which is
        intended. A new phone restores through recovery, which rebuilds the
        local database from material neither the server nor Google can read.

        dataExtractionRules says the same thing again for Android 12 and above,
        where the platform reads it in preference to allowBackup.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Share to PINGO from anywhere.

                Without these the app is absent from the system share sheet, and
                sharing a photo or a link means copying it, opening PINGO, finding
                the chat and pasting - which is enough friction that people simply
                do not share to it.

                This used to claim text and images only, on the reasoning that
                a */* filter puts PINGO in front of every share and then fails
                on the ones it cannot send. The reasoning was right and the
                premise was wrong: the attach menu takes any file at all, so
                there is no such thing as a share PINGO cannot send. Claiming
                images only meant sharing a PDF or a video from another app
                simply did not offer PINGO - not because it could not do it,
                but because it never said it could.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!--
            The channel a push falls back to if it names one that does not exist.

            Every notification PINGO sends names `pingo_messages`, which the app
            creates at registration. This is the safety net for the gap between
            install and that call, and for a payload that ever names something
            else: without it, Android 8 and up drops a notification with an
            unknown channel silently - no sound, no log, nothing to notice.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pingo_messages" />

        <!--
            Without these two, Android silhouettes the launcher icon - a colour
            bitmap whose every opaque pixel becomes white - and the result is a
            featureless white square in the status bar.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />

        <!--
            No service declared here for the screen share.

            Android will not let an app hold a MediaProjection without a
            foreground service of type mediaProjection, and this used to declare
            one. livekit-android ships and declares its own, with the right
            type and its own notification, and `startForegroundService` on the
            track binds to it - so a second one meant two notifications for one
            screen share and a manifest entry duplicating a dependency's. See
            ScreenShare.kt.
        -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        What PINGO actually asks for, and nothing beyond it.

        Every one of these is used by a feature that already exists: the camera
        and microphone by Pings, stories and calls; notifications by the badge;
        network state by the offline banner. Android grants the dangerous ones
        at runtime, so declaring them here only makes the request possible: the
        user is still asked, once, at the moment the feature is opened.

        Deliberately absent: contacts and location. Both are named as future
        features, and a permission declared before it is used shows up in the
        store listing as something the app wants for no visible reason.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Screen sharing in a call.

        Neither of these is a runtime prompt - the system's own capture dialog
        is what asks the user, every session, and it cannot be remembered. These
        two only make it legal for the service to hold the projection while the
        app is in the background, which is the entire point: people share a
        screen in order to go and look at something else.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Declared optional so the app stays installable on a device without one.
        The default for a CAMERA permission is required=true, which would hide
        PINGO from tablets that have no rear camera.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
